# NEVER insert a token into source code or commit your real .env.
# Reset the exposed token before using this project.
DISCORD_TOKEN=REPLACE_WITH_NEW_TOKEN
GUILD_ID=0
DEPLOY_CHANNEL_ID=0
# Give this role only to approved beta testers. Developer Mode -> Copy ID.
REQUIRED_ROLE_ID=0
OPEN_BETA=false
NODE_NAME="Local Node"
VPS_IMAGE=cloudy/ubuntu:22.04-sshx
DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_RUNTIME=runc
DATA_DIR=/var/lib/cloudy-vps
VPS_RAM_GIB=15
VPS_CPUS=3
VPS_DISK_GIB=75
MAX_VPS_TOTAL=1
HOST_RESERVE_RAM_GIB=2
HOST_RESERVE_CPUS=1
HOST_RESERVE_DISK_GIB=10
LEASE_DAYS=30
EXPIRED_RETENTION_HOURS=72
SSHX_TTL_SECONDS=900
# The runtime bot does not need or receive a Freestyle API key.
